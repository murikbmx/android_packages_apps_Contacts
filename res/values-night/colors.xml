<resources>
    <!-- Most colors follow the Material 3 roles in values(-night)/m3_colors.xml.
         Only the hard-coded translucent black values need a dark counterpart. -->

    <!-- Color of disabled text and unfocused hint text inside the contact editor. -->
    <color name="editor_disabled_text_color">#61ffffff</color>

    <!-- Color of text on disabled link contacts button. -->
    <color name="disabled_button_text">#61ffffff</color>

    <!-- Color of background of disabled link contacts button. -->
    <color name="disabled_button_background">#26ffffff</color>

    <!-- Color of text of people names in contact list when item is disabled. -->
    <color name="disabled_contact_list_name_text">#61ffffff</color>

    <color name="control_highlight_color">#1Affffff</color>

    <!-- Material 3 tonal letter tiles (circular avatars): container / on-container pairs -->
    <color name="letter_tile_tonal_1">@android:color/system_accent1_700</color>
    <color name="letter_tile_tonal_font_1">@android:color/system_accent1_100</color>
    <color name="letter_tile_tonal_2">@android:color/system_accent2_700</color>
    <color name="letter_tile_tonal_font_2">@android:color/system_accent2_100</color>
    <color name="letter_tile_tonal_3">@android:color/system_accent3_700</color>
    <color name="letter_tile_tonal_font_3">@android:color/system_accent3_100</color>
    <color name="letter_tile_tonal_4">@android:color/system_accent1_800</color>
    <color name="letter_tile_tonal_font_4">@android:color/system_accent1_200</color>
    <color name="letter_tile_tonal_5">@android:color/system_accent2_800</color>
    <color name="letter_tile_tonal_font_5">@android:color/system_accent2_200</color>
    <color name="letter_tile_tonal_6">@android:color/system_accent3_800</color>
    <color name="letter_tile_tonal_font_6">@android:color/system_accent3_200</color>
</resources>
