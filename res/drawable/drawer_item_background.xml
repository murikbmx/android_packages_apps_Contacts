<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Material 3 navigation drawer: selected item is a rounded tonal pill -->
  <item android:state_activated="true">
    <inset android:insetLeft="@dimen/drawer_item_pill_inset"
           android:insetRight="@dimen/drawer_item_pill_inset">
      <shape android:shape="rectangle">
        <solid android:color="@color/drawer_selected_color" />
        <corners android:radius="@dimen/drawer_item_pill_radius" />
      </shape>
    </inset>
  </item>
  <item>
    <inset android:insetLeft="@dimen/drawer_item_pill_inset"
           android:insetRight="@dimen/drawer_item_pill_inset">
      <ripple android:color="@color/control_highlight_color">
        <item android:id="@android:id/mask">
          <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/drawer_item_pill_radius" />
          </shape>
        </item>
      </ripple>
    </inset>
  </item>
</selector>